# Credenciales de Grafana (copiar a .env). .env esta en .gitignore: no versionar.
# scripts/deploy.sh y scripts/setup-services.sh crean .env con una clave aleatoria si falta.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=cambiame

# --- SSO / notificaciones (servicio notify) ---
# AUTH_SECRET_KEY debe ser EXACTAMENTE el valor de BACKUP_SECRET_KEY de
# /etc/backupcsr/web.env, para que la cookie de sesión valide en copias,
# portal (index) y UPS. AUTH_COOKIE/AUTH_SALT deben coincidir con
# backupcsr/web/app/auth.py.
AUTH_SECRET_KEY=
AUTH_COOKIE=backupcsr_session
AUTH_SALT=backupcsr-session
# Credenciales generales del login único (index.cortexdev.win). Son las únicas
# de acceso: la misma sesión entra en copias, ups y demás entornos.
AUTH_GENERAL_USER=
AUTH_GENERAL_PASSWORD=
AUTH_GENERAL_ROLE=admin
# Token para que las apps publiquen eventos en notify (POST /api/events).
NOTIFY_INGEST_TOKEN=
NOTIFY_LOGIN_URL=https://index.cortexdev.win/login.html

# --- Firebase Cloud Messaging (web) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=
# Ruta DENTRO del contenedor notify (monta ./firebase-service-account.json).
# Debe estar FUERA de /data para no solapar con el bind del volumen.
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/firebase/service-account.json

# --- Correo (opcional; por defecto reutiliza BACKUP_ALERT_*) ---
NOTIFY_MAIL_TO=
