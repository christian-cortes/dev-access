# Certificados locales de mkcert: nunca versionar (incluye la llave privada).
certs/
*.pem
*.key

# Datos runtime de portal-api (SQLite). Se recrea desde backend/catalog.yml.
backend/data/

# Portal generado desde catalog.yml (scripts/build-portal.py).
portal/dist/

# Secretos de monitoring (clave admin de Grafana). Usar .env.example como plantilla.
.env

# Credenciales de Firebase (service account). Nunca versionar.
firebase-service-account*.json
*service-account*.json

# Python
__pycache__/
*.pyc
.kilo

# backupcsr: secretos y llaves locales (nunca versionar; solo los .example).
backupcsr/conf/*.env
backupcsr/conf/*.creds
backupcsr/conf/fstab.backupcsr
backupcsr/keys/
*.ppk

# Portal de copias: configuración real (web.env), nunca versionar.
backupcsr/web/conf/*.env
backupcsr/web/venv/

ups/data/
ups/__pycache__/

# Datos runtime del servicio notify (SQLite y cuenta de servicio montada).
notify/data/
