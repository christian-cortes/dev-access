# Configuración del portal de copias (backupcsr-web).
# Copiar a /etc/backupcsr/web.env con permisos 0600 root:root.
# NUNCA versionar el archivo real; solo este ejemplo.

# --- Base de datos MySQL (ubuntu-docker .87, esquema backupcsr) ---
BACKUP_DB_HOST=192.168.0.87
BACKUP_DB_PORT=3306
BACKUP_DB_NAME=backupcsr
BACKUP_DB_USER=backupcsr_web
BACKUP_DB_PASSWORD=CAMBIAR

# --- Sesión / cookies (cadena aleatoria larga) ---
BACKUP_SECRET_KEY=CAMBIAR

# --- Gestión del cron: 0 = solo lectura + ejecutar; 1 = además edita /etc/cron.d/backupcsr ---
BACKUP_MANAGE_CRON=0

# --- Planificador de copias (backupcsr-scheduler) ---
# 1 = el cron encola y el daemon controla la concurrencia (2 copias a la vez, 1 por
#     host) y reintenta fallos transitorios; 0 = modo anterior (MIRROR_GATE serial).
BACKUP_SCHEDULER=0
# BACKUP_MAX_JOBS=2                # copias simultáneas en total
# BACKUP_MAX_PER_HOST=1            # copias simultáneas por origin_host
# BACKUP_RETRY_MAX=3               # reintentos por ronda ante fallo transitorio
# BACKUP_RETRY_BACKOFF=300,900,2700 # esperas entre reintentos (segundos)
# BACKUP_RETRY_JITTER=0.2          # ±20% aleatorio sobre cada espera
# BACKUP_JOB_TIMEOUT=5400          # tope de duración de una ronda (s); al vencer se mata el
#                                  # grupo de procesos y se reencola como transitorio (0 = sin tope)
# BACKUP_SCHEDULER_SOCKET=/run/backupcsr/scheduler.sock
# BACKUP_SCHEDULER_STATE=/var/lib/backupcsr/scheduler.json

# --- Usuario admin inicial (lo crea install.sh si la tabla users está vacía) ---
BACKUP_ADMIN_USER=admin
# BACKUP_ADMIN_PASSWORD=dejar vacío para que install.sh genere una aleatoria

# --- Opcionales (valores por defecto) ---
# BACKUP_ETC=/etc/backupcsr
# BACKUP_OPT=/opt/backupcsr
# BACKUP_LOG=/var/log/backupcsr
# BACKUP_NAS=/mnt/nas
# BACKUP_CRON=/etc/cron.d/backupcsr
# BACKUP_TZ=America/Bogota
# BACKUP_POLL_INTERVAL=30
# BACKUP_GRACE_MIN=90

# --- Tamaño (GB por tarea) ---
# BACKUP_SIZE_TTL=600             # segundos de caché del tamaño por job
# BACKUP_SIZE_MAX_ENTRIES=500000  # tope de archivos recorridos por escaneo
# BACKUP_SIZE_TIMEOUT=120         # segundos máximos por escaneo (devuelve parcial)
# BACKUP_NAS_MIN_FREE_PCT=10      # % de uso del NAS que dispara alerta
# BACKUP_SIZE_SNAPSHOT=1          # guardar snapshot al cerrar cada corrida y diario

# --- Alertas por correo (opcional; vacío = solo campana del portal) ---
# fatal -> correo inmediato; transitorio/parcial/contención -> resumen diario
# (cron: venv/bin/python -m app.cli notify-digest). Sin SMTP usa /usr/sbin/sendmail.
# BACKUP_ALERT_MAIL_TO=copias@cortexdev.win
# BACKUP_ALERT_MAIL_FROM=backupcsr@cortexdev.win
# BACKUP_ALERT_SMTP_HOST=127.0.0.1
# BACKUP_ALERT_SMTP_PORT=25
# BACKUP_ALERT_SMTP_USER=
# BACKUP_ALERT_SMTP_PASS=
# BACKUP_ALERT_SMTP_TLS=0
