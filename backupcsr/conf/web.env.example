# Entorno del portal web de copias (backupcsr-web.service: EnvironmentFile).
# Copiar a /etc/backupcsr/web.env, completar BACKUP_DB_* y ajustar lo que aplique:
#   install -m 0600 conf/web.env.example /etc/backupcsr/web.env
# `web/install.sh` lo crea desde este ejemplo si no existe y genera BACKUP_SECRET_KEY.
# Tras cualquier cambio: systemctl restart backupcsr-web

# --- Base de datos MySQL (obligatoria) ---
BACKUP_DB_HOST=127.0.0.1
BACKUP_DB_PORT=3306
BACKUP_DB_NAME=backupcsr
BACKUP_DB_USER=backupcsr_web
BACKUP_DB_PASSWORD=CAMBIAR

# --- Sesión (la rellena install.sh si está vacía) ---
# Sin clave persistente las sesiones no sobreviven reinicios.
BACKUP_SECRET_KEY=
# BACKUP_SESSION_MAX_AGE=43200        # segundos de validez de la cookie (12 h)
# BACKUP_COOKIE_SECURE=1              # 0 solo para probar contra http://127.0.0.1:8089

# --- Comportamiento ---
# BACKUP_MANAGE_CRON=0                # 1 = el portal reescribe /etc/cron.d/backupcsr
# BACKUP_MANAGE_JOBS=0                # 1 = crear/editar/eliminar tareas desde el portal
#                                     # (script + credenciales + catálogo + cron). Solo admin.
# BACKUP_TZ=America/Bogota            # zona con la que se interpretan los logs
# BACKUP_POLL_INTERVAL=30             # segundos entre ciclos de sondeo
# BACKUP_GRACE_MIN=90                 # minutos de gracia antes de marcar un job como TARDE
# BACKUP_MAX_RUN_FILES=5000           # tope de archivos guardados por corrida

# --- Rutas (por defecto, las del subsistema) ---
# BACKUP_ETC=/etc/backupcsr
# BACKUP_OPT=/opt/backupcsr
# BACKUP_LOG=/var/log/backupcsr
# BACKUP_NAS=/mnt/nas
# BACKUP_CRON=/etc/cron.d/backupcsr
# BACKUP_CATALOG=/opt/backupcsr/web/jobs.yml
# BACKUP_SCHEMA=/opt/backupcsr/web/schema.sql
# BACKUP_JOBS_DIR=/etc/backupcsr/jobs.d       # overlay de tareas creadas desde el portal
# BACKUP_CREDENTIALS=/etc/backupcsr/credentials.env

# --- Tamaño almacenado (GB por tarea) ---
# BACKUP_SIZE_TTL=1800                # segundos de caché de la medida
# BACKUP_SIZE_MAX_ENTRIES=500000      # tope de entradas recorridas
# BACKUP_SIZE_TIMEOUT=120             # segundos por recorrido
# BACKUP_SIZE_WARM_PAUSE=2            # pausa entre jobs del refresco en segundo plano
# BACKUP_NAS_MIN_FREE_PCT=10          # umbral de aviso de NAS lleno
# BACKUP_SIZE_SNAPSHOT=1              # guardar histórico de tamaños

# --- Gestión de archivos (pestaña Archivos; ver web/README.md) ---
# BACKUP_MANAGE_FILES=1               # 0 = pestaña de solo lectura
# BACKUP_FILES_MAX_UPLOAD_MB=512      # tope por archivo subido
# BACKUP_FILES_CONFIRM_MB=100         # desde este tamaño se exige escribir el nombre para borrar

# --- Alertas por correo (opcional; vacío = solo campana del portal) ---
# fatal -> correo inmediato; transitorio/parcial/contención -> resumen diario
# (cron: venv/bin/python -m app.cli notify-digest). Sin SMTP usa /usr/sbin/sendmail.
# BACKUP_ALERT_MAIL_TO=copias@cortexdev.win
# BACKUP_ALERT_MAIL_FROM=backupcsr@cortexdev.win
# BACKUP_ALERT_SMTP_HOST=127.0.0.1
# BACKUP_ALERT_SMTP_PORT=25
# BACKUP_ALERT_SMTP_USER=
# BACKUP_ALERT_SMTP_PASS=
# BACKUP_ALERT_SMTP_TLS=0

# --- Admin inicial (solo si la tabla users está vacía) ---
# BACKUP_ADMIN_USER=admin
# BACKUP_ADMIN_PASSWORD=CAMBIAR
