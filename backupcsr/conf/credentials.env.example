# Credenciales de las copias de seguridad.
# Copiar a /etc/backupcsr/credentials.env, reemplazar cada CAMBIAR y aplicar:
#   chown root:root /etc/backupcsr/credentials.env
#   chmod 600 /etc/backupcsr/credentials.env
#
# Los valores se toman de texts/script_*.txt, donde estaban en texto plano.
# Nota: si una clave contiene espacios, #, $ o comillas, escribirla entre comillas simples.

# --- Google (SFTP con llave privada; la llave va en /etc/backupcsr/keys/google) ---
GOOGLE_BD_HOST=35.185.102.160
GOOGLE_BD_PORT=22
GOOGLE_BD_USER=administrador

GOOGLE_WEB_HOST=35.229.110.253
GOOGLE_WEB_PORT=22
GOOGLE_WEB_USER=administrador

# --- Latino (SFTP con llave privada; llave en /etc/backupcsr/keys/latino) ---
LATINO_HOST=158.106.128.218
LATINO_PORT=2200
LATINO_USER=chequeos
# Opcional: respaldo si la llave /etc/backupcsr/keys/latino no funcionara (SFTP con sshpass).
# LATINO_PASS=CAMBIAR

# --- Ruta56 (FTP) ---
RUTA56_HOST=162.240.175.168
RUTA56_USER=wwruta
RUTA56_PASS=CAMBIAR

# --- Ticware (FTP) ---
TICWARE_HOST=ftp.ticware.net
TICWARE_USER=developer
TICWARE_PASS=CAMBIAR

# --- Gastro (FTP) ---
GASTRO_HOST=162.240.224.170
GASTRO_USER=wwgast
GASTRO_PASS=CAMBIAR

# --- Enter (FTP) ---
ENTER_HOST=162.240.166.173
ENTER_USER=wwente
ENTER_PASS=CAMBIAR

# --- Opcionales (descomentar para sobreescribir los valores por defecto) ---
# BACKUPCSR_NAS_ROOT=/mnt/nas
# MIRROR_PARALLEL=2
#
# Presión sobre el servidor (ver README, "Cuándo compite con el servidor"):
# MIRROR_GATE=/run/lock/backupcsr-gate.lock   # cola global: un job a la vez (vacío = sin cola)
# GATE_WAIT=1800                              # segundos máximos de espera por el turno
# JOB_NICE=15                                 # prioridad de CPU del job (hijos heredan)
# JOB_IONICE_CLASS=2                          # clase de I/O (2 = best-effort)
# JOB_IONICE_LEVEL=7                          # 0 (más prioridad) a 7 (menos)
# MIRROR_COMPARE=size                         # size = solo nuevos/cambiados de tamaño
# MIRROR_RATE_LIMIT=0                         # bytes/s por corrida (p. ej. 5M); 0 = sin límite
# MIRROR_MAX_ERRORS=20                        # aborta la corrida tras N errores
